[Unit]
Description=Iruvy website contact form API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/iruvy-contact.env
ExecStart=/usr/bin/python3 /opt/iruvy-contact/contact_api.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=iruvy-contact
StateDirectoryMode=0750
UMask=0077
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
